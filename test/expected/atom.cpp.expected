    constexpr common_comparison_category_t<__detail::__synth3way_t<_T1, _U1>,
					   __detail::__synth3way_t<_T2, _U2>>
    operator<=>(const pair<_T1, _T2>& __x, const pair<_U1, _U2>& __y)
