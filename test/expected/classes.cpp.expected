namespace testspace {

class BondMap {
   
   
   public:
      struct MAtom;
	  struct MBond {
           list<struct MAtom>::iterator atom1;
	  };
	
	  struct MAtom {
			int a;
      };
};


class Top {};
class Top2 {};

class Derived1 : public Top {};
class Derived2 : public virtual Top, public Top2 {};

}
