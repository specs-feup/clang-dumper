      template<__eligible_pair_like<pair> _UPair>
	requires (_S_constructible_from_pair_like<_UPair>())
	  && (_S_dangles_from_pair_like<_UPair>())
	constexpr explicit(!_S_convertible_from_pair_like<_UPair>())
	pair(_UPair&&) = delete;
