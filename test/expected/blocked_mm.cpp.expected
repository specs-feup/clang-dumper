				  decltype(std::get<1>(std::declval<_UPair>()))>();
	}

      template<typename _UPair>
	static constexpr bool
	_S_convertible_from_pair_like()
	{
	  return _S_convertible<decltype(std::get<0>(std::declval<_UPair>())),
				decltype(std::get<1>(std::declval<_UPair>()))>();
	}

      template<typename _UPair>
	static constexpr bool
	_S_dangles_from_pair_like()
	{
