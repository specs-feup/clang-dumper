  template<typename _Alloc>
    [[__gnu__::__always_inline__]]
    inline void __do_alloc_on_move(_Alloc& __one, _Alloc& __two, true_type)
    { __one = std::move(__two); }

  template<typename _Alloc>
    [[__gnu__::__always_inline__]]
    inline void __do_alloc_on_move(_Alloc&, _Alloc&, false_type)
    { }
