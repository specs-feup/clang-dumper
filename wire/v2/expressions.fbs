include "statements.fbs";
namespace astwire.v2;

// Expression handlers use explicit base composition. Every concrete payload
// carries the complete ClavaNodeData -> StmtData -> ExprData ancestry through base.
table ExprData  {
  base:StmtData (required);
  type:long = null;
  value_kind:ValueKind = null;
  object_kind:ObjectKind = null;
  is_default_argument:bool = null;
}

table CastExprData  {
  base:ExprData (required);
  cast_kind:CastKind = null;
}

table CXXUnresolvedConstructExprData {
  base:ExprData (required);
  is_list_initialization:bool = null;
}

table LiteralData  {
  base:ExprData (required);
  source_literal:string (required);
}

table CharacterLiteralData  {
  base:LiteralData (required);
  value:long = null;
  kind:CharacterKind = null;
}

table IntegerLiteralData  {
  base:LiteralData (required);
  value:string (required);
}

table FloatingLiteralData  {
  base:LiteralData (required);
  value:double = null;
}

table StringLiteralData  {
  base:LiteralData (required);
  string_kind:StringKind = null;
  length:long = null;
  char_byte_width:int = null;
  string_bytes:[ubyte] (required);
}

table CXXBoolLiteralExprData  {
  base:LiteralData (required);
  value:bool = null;
}

table CompoundLiteralExprData  {
  base:LiteralData (required);
  is_file_scope:bool = null;
}

table InitListExprData  {
  base:ExprData (required);
  array_filler:long = null;
  is_explicit:bool = null;
  is_string_literal_init:bool = null;
  syntactic_form:long = null;
  semantic_form:long = null;
}

table DeclRefExprData  {
  base:ExprData (required);
  qualifier:string (required);
  template_arguments:[TemplateArgument] (required);
  decl:long = null;
}

table OverloadExprData  {
  base:ExprData (required);
  qualifier:string (required);
  name:string (required);
  unresolved_decls:[long] (required);
  template_arguments:[TemplateArgument] (required);
}

table CXXConstructExprData  {
  base:ExprData (required);
  is_elidable:bool = null;
  requires_zero_initialization:bool = null;
  is_list_initialization:bool = null;
  is_std_list_initialization:bool = null;
  construction_kind:ConstructionKind = null;
  is_temporary_object:bool = null;
  constructor_decl:long = null;
}

table CXXTemporaryObjectExprData  {
  base:CXXConstructExprData (required);
}

table MemberExprData  {
  base:ExprData (required);
  is_arrow:bool = null;
  member_name:string (required);
  member_decl:long = null;
  found_decl:long = null;
  found_decl_access_specifier:AccessSpecifier = null;
}

table MaterializeTemporaryExprData  {
  base:ExprData (required);
  extending_decl:long = null;
}

table BinaryOperatorData  {
  base:ExprData (required);
  op:BinaryOperatorKind = null;
}

table UnresolvedMemberExprData  {
  base:OverloadExprData (required);
}

table UnresolvedLookupExprData  {
  base:OverloadExprData (required);
  requires_adl:bool = null;
}

table CallExprData  {
  base:ExprData (required);
  direct_callee:long = null;
}

table CXXMemberCallExprData  {
  base:CallExprData (required);
  method_decl:long = null;
}

table CXXTypeidExprData  {
  base:ExprData (required);
  is_type_operand:bool = null;
  operand:long = null;
}

table ExplicitCastExprData  {
  base:CastExprData (required);
  type_as_written:long = null;
}

table CXXNamedCastExprData  {
  base:ExplicitCastExprData (required);
  cast_name:string (required);
}

table CXXDependentScopeMemberExprData  {
  base:ExprData (required);
  is_arrow:bool = null;
  member_name:string (required);
  is_implicit_access:bool = null;
  qualifier:string (required);
  has_template_keyword:bool = null;
  template_arguments:[TemplateArgument] (required);
}

table UnaryOperatorData  {
  base:ExprData (required);
  op:UnaryOperatorKind = null;
  position:UnaryOperatorPosition = null;
}

table UnaryExprOrTypeTraitExprData  {
  base:ExprData (required);
  kind:UnaryExprOrTypeTrait = null;
  is_argument_type:bool = null;
  arg_type:long = null;
  source_literal:string (required);
}

table CXXNewExprData  {
  base:ExprData (required);
  is_global:bool = null;
  is_array:bool = null;
  initialization_present:bool = null;
  init_style:NewInitStyle = null;
  initializer:long = null;
  construct_expr:long = null;
  array_size:long = null;
  operator_new:long = null;
}

table CXXDeleteExprData  {
  base:ExprData (required);
  is_global:bool = null;
  is_array:bool = null;
  is_array_as_written:bool = null;
}

table OffsetOfExprData  {
  base:ExprData (required);
  source_type:long = null;
  components:[OffsetOfComponent] (required);
}

table LambdaExprData  {
  base:ExprData (required);
  is_generic_lambda:bool = null;
  is_mutable:bool = null;
  has_explicit_parameters:bool = null;
  has_explicit_result_type:bool = null;
  capture_default:LambdaCaptureDefault = null;
  lambda_class:long = null;
  capture_kinds:[LambdaCaptureKind] (required);
  init_capture_names:[string] (required);
  capture_init_styles:[InitializationStyle] (required);
  capture_pack_expansions:[bool] (required);
  capture_is_implicit:[bool] (required);
}

table PredefinedExprData  {
  base:ExprData (required);
  predefined_type:PredefinedIdType = null;
}

table SizeOfPackExprData  {
  base:ExprData (required);
  is_partially_substituted:bool = null;
  pack:long = null;
  partial_arguments:[TemplateArgument] (required);
}

table ArrayInitLoopExprData  {
  base:ExprData (required);
}

table DesignatedInitExprData  {
  base:ExprData (required);
  uses_gnu_syntax:bool = null;
  designators:[Designator] (required);
}

table DependentScopeDeclRefExprData  {
  base:ExprData (required);
  decl_name:string (required);
  qualifier:string (required);
  has_template_keyword:bool = null;
  template_arguments:[TemplateArgument] (required);
}

table CXXNoexceptExprData  {
  base:ExprData (required);
  value:bool = null;
}

table CXXPseudoDestructorExprData  {
  base:ExprData (required);
  qualifier:string (required);
  is_arrow:bool = null;
  destroyed_type:long = null;
}

table PseudoObjectExprData  {
  base:ExprData (required);
  result_expr_index:int = null;
}

table MSPropertyRefExprData  {
  base:ExprData (required);
  base_expr:long = null;
  property_decl:long = null;
  is_implicit_access:bool = null;
  is_arrow:bool = null;
}
