include "statements.fbs";
namespace astwire.v2;

// Expression handlers use explicit base composition. Every concrete payload
// carries the complete ClavaNodeData -> StmtData -> ExprData ancestry through base.
table ExprData {
  base:StmtData (required);
  type:long = null (ref: "Type", optional);
  value_kind:ValueKind = null (clang_value: "valueKind(node->getValueKind())");
  object_kind:ObjectKind = null (clang_value: "objectKind(node->getObjectKind())");
  is_default_argument:bool = null;
}

table CastExprData {
  base:ExprData (required);
  cast_kind:CastKind = null (clang_enum: "CAST_KIND");
}

table CXXUnresolvedConstructExprData {
  base:ExprData (required);
  is_list_initialization:bool = null;
}

table LiteralData (clang_class: "Expr") {
  base:ExprData (required);
  source_literal:string (required, clang_value: "sourceText(node->getSourceRange(), c)");
}

table CharacterLiteralData {
  base:LiteralData (required);
  value:long = null;
  kind:CharacterKind = null (clang_enum: "CHARACTER_LITERAL_KIND");
}

table IntegerLiteralData {
  base:LiteralData (required);
  value:string (required, clang_value: "integerText(node)");
}

table FloatingLiteralData {
  base:LiteralData (required);
  value:double = null (clang_value: "approximateDouble(node)");
}

table StringLiteralData {
  base:LiteralData (required);
  string_kind:StringKind = null (clang: "node->getKind()", clang_enum: "STRING_KIND");
  /// Number of characters of the string.
  length:long = null;
  /// Number of bytes per character.
  char_byte_width:int = null;
  string_bytes:[ubyte] (required, clang_value: "stringBytes(node)");
}

table CXXBoolLiteralExprData {
  base:LiteralData (required);
  value:bool = null;
}

table CompoundLiteralExprData {
  base:LiteralData (required);
  is_file_scope:bool = null;
}

table InitListExprData {
  base:ExprData (required);
  /// OPTIONAL - If this initializer list initializes an array with more elements than there are initializers in the
  /// list, specifies an expression to be used for value initialization of the rest of the elements.
  array_filler:long = null (ref: "Expr", optional);
  is_explicit:bool = null (clang: "const_cast<clang::InitListExpr *>(node)->isExplicit()");
  is_string_literal_init:bool = null;
  /// Represents the initializer list as written by the user, which may contain C99 designated initializers
  /// (represented as DesignatedInitExprs), initializations of sub-object members without explicit braces, and so on.
  /// If the syntactic and semantic forms are the same for this initializer, it returns empty.
  syntactic_form:long = null (ref: "InitListExpr", optional);
  semantic_form:long = null (ref: "InitListExpr", optional);
}

table DeclRefExprData {
  base:ExprData (required);
  /// The nested-name qualifier that precedes the name, or empty string if it has none.
  qualifier:string (required, clang_value: "qualifierString(node->getQualifier(), c)");
  template_arguments:[TemplateArgument] (required, clang_value: "templateArguments(node, c)");
  decl:long = null (ref: "ValueDecl");
}

table OverloadExprData {
  base:ExprData (required);
  /// The nested-name qualifier that precedes the name, or empty string if it has none.
  qualifier:string (required, clang_value: "qualifierString(node->getQualifier(), c)");
  /// The looked up name.
  name:string (required, clang_value: "node->getName().getAsString()");
  /// The declarations in the unresolved set.
  unresolved_decls:[long] (required, ref: "Decl", clang: "node->decls()");
  template_arguments:[TemplateArgument] (required, clang_value: "templateArguments(node, c)");
}

table CXXConstructExprData {
  base:ExprData (required);
  is_elidable:bool = null;
  requires_zero_initialization:bool = null (clang: "node->requiresZeroInitialization()");
  is_list_initialization:bool = null;
  is_std_list_initialization:bool = null (clang: "node->isStdInitListInitialization()");
  construction_kind:ConstructionKind = null (clang_enum: "CONSTRUCTION_KIND");
  is_temporary_object:bool = null (clang: "node->isTemporaryObject(*c.ast, node->getConstructor()->getParent())");
  constructor_decl:long = null (ref: "CXXConstructorDecl", clang: "node->getConstructor()");
}

table CXXTemporaryObjectExprData {
  base:CXXConstructExprData (required);
}

table MemberExprData {
  base:ExprData (required);
  is_arrow:bool = null;
  member_name:string (required, clang_value: "node->getMemberNameInfo().getAsString()");
  member_decl:long = null (ref: "ValueDecl");
  found_decl:long = null (ref: "NamedDecl", clang: "node->getFoundDecl().getDecl()");
  found_decl_access_specifier:AccessSpecifier = null (clang: "node->getFoundDecl().getAccess()", clang_enum: "ACCESS_SPECIFIER");
}

table MaterializeTemporaryExprData {
  base:ExprData (required);
  extending_decl:long = null (ref: "Decl", optional);
}

table BinaryOperatorData {
  base:ExprData (required);
  op:BinaryOperatorKind = null (clang: "node->getOpcode()", clang_enum: "BINARY_OPERATOR_KIND");
}

table UnresolvedMemberExprData {
  base:OverloadExprData (required);
}

table UnresolvedLookupExprData {
  base:OverloadExprData (required);
  /// True if this declaration should be extended by argument-dependent lookup.
  requires_adl:bool = null (clang: "node->requiresADL()");
}

table CallExprData {
  base:ExprData (required);
  direct_callee:long = null (ref: "FunctionDecl", optional);
}

table CXXMemberCallExprData {
  base:CallExprData (required);
  method_decl:long = null (ref: "CXXMethodDecl", optional);
}

table CXXTypeidExprData {
  base:ExprData (required);
  is_type_operand:bool = null;
  operand:long = null (ref: "ClavaNode", clang_value: "node->isTypeOperand() ? clava::getId(node->getTypeOperand(*c.ast), c.id) : clava::getId(node->getExprOperand(), c.id)");
}

table ExplicitCastExprData {
  base:CastExprData (required);
  type_as_written:long = null (ref: "Type");
}

table CXXNamedCastExprData {
  base:ExplicitCastExprData (required);
  cast_name:string (required);
}

table CXXDependentScopeMemberExprData {
  base:ExprData (required);
  is_arrow:bool = null;
  member_name:string (required, clang_value: "node->getMemberNameInfo().getAsString()");
  is_implicit_access:bool = null;
  qualifier:string (required, clang_value: "qualifierString(node->getQualifier(), c)");
  has_template_keyword:bool = null;
  template_arguments:[TemplateArgument] (required, clang_value: "templateArguments(node, c)");
}

table UnaryOperatorData {
  base:ExprData (required);
  op:UnaryOperatorKind = null (clang: "node->getOpcode()", clang_enum: "UNARY_OPERATOR_KIND");
  position:UnaryOperatorPosition = null (clang_value: "position(node)");
}

table UnaryExprOrTypeTraitExprData {
  base:ExprData (required);
  kind:UnaryExprOrTypeTrait = null (clang_enum: "UETT_KIND");
  is_argument_type:bool = null;
  arg_type:long = null (ref: "Type", optional, clang_value: "node->isArgumentType() ? clava::getId(node->getArgumentType(), c.id) : -1");
  source_literal:string (required, clang_value: "sourceText(node->getSourceRange(), c)");
}

table CXXNewExprData {
  base:ExprData (required);
  is_global:bool = null (clang: "node->isGlobalNew()");
  is_array:bool = null;
  initialization_present:bool = null (clang: "node->hasInitializer()");
  init_style:NewInitStyle = null (clang: "node->getInitializationStyle()", clang_enum: "NEW_INIT_STYLE");
  initializer:long = null (ref: "Expr", optional);
  construct_expr:long = null (ref: "CXXConstructExpr", optional);
  array_size:long = null (ref: "Expr", optional);
  operator_new:long = null (ref: "FunctionDecl", optional);
}

table CXXDeleteExprData {
  base:ExprData (required);
  is_global:bool = null (clang: "node->isGlobalDelete()");
  is_array:bool = null (clang: "node->isArrayForm()");
  is_array_as_written:bool = null (clang: "node->isArrayFormAsWritten()");
}

table OffsetOfExprData {
  base:ExprData (required);
  source_type:long = null (ref: "Type", clang: "node->getTypeSourceInfo()->getType()");
  components:[OffsetOfComponent] (required, clang_value: "offsetOfComponents(node, c)");
}

table LambdaExprData (clang_manual) {
  base:ExprData (required);
  is_generic_lambda:bool = null;
  is_mutable:bool = null;
  has_explicit_parameters:bool = null;
  has_explicit_result_type:bool = null;
  capture_default:LambdaCaptureDefault = null;
  lambda_class:long = null (ref: "CXXRecordDecl");
  capture_kinds:[LambdaCaptureKind] (required);
  init_capture_names:[string] (required);
  capture_init_styles:[InitializationStyle] (required);
  capture_pack_expansions:[bool] (required);
  capture_is_implicit:[bool] (required);
}

table PredefinedExprData {
  base:ExprData (required);
  predefined_type:PredefinedIdType = null (clang: "node->getIdentKind()", clang_enum: "PREDEFINED_ID_TYPE");
}

table SizeOfPackExprData {
  base:ExprData (required);
  is_partially_substituted:bool = null;
  pack:long = null (ref: "NamedDecl");
  partial_arguments:[TemplateArgument] (required, clang_value: "partialArguments(node, c)");
}

table ArrayInitLoopExprData {
  base:ExprData (required);
}

table DesignatedInitExprData {
  base:ExprData (required);
  uses_gnu_syntax:bool = null (clang: "node->usesGNUSyntax()");
  designators:[Designator] (required, clang_value: "designators(node, c)");
}

table DependentScopeDeclRefExprData {
  base:ExprData (required);
  /// The name that this expression refers to.
  decl_name:string (required, clang_value: "node->getDeclName().getAsString()");
  /// The nested-name qualifier that precedes the name, or empty string if it has none.
  qualifier:string (required, clang_value: "qualifierString(node->getQualifier(), c)");
  /// True if the name was preceded by the template keyword.
  has_template_keyword:bool = null;
  /// The explicit template arguments of this lookup.
  template_arguments:[TemplateArgument] (required, clang_value: "templateArguments(node, c)");
}

table CXXNoexceptExprData {
  base:ExprData (required);
  value:bool = null;
}

table CXXPseudoDestructorExprData {
  base:ExprData (required);
  qualifier:string (required, optional, clang_value: "node->hasQualifier() ? qualifierString(node->getQualifier(), c) : std::string()");
  is_arrow:bool = null;
  destroyed_type:long = null (ref: "Type");
}

table PseudoObjectExprData {
  base:ExprData (required);
  result_expr_index:int = null (clang_value: "resultExprIndex(node)");
}

table MSPropertyRefExprData {
  base:ExprData (required);
  base_expr:long = null (ref: "Expr");
  property_decl:long = null (ref: "MSPropertyDecl");
  is_implicit_access:bool = null;
  is_arrow:bool = null;
}
