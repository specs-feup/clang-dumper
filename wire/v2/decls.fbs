}

table LinkageSpecDeclData {
  base:DeclData (required);
  linkage_type:LanguageId = null (java_key:"pt.up.fe.specs.clava.ast.decl.LinkageSpecDecl.LINKAGE_TYPE", java_enum:"pt.up.fe.specs.clava.ast.decl.enums.LanguageId");
}

table StaticAssertDeclData {
  base:DeclData (required);
  is_failed:bool = null (java_key:"pt.up.fe.specs.clava.ast.decl.StaticAssertDecl.IS_FAILED");
}

table TemplateTemplateParmDeclData {
  base:TemplateDeclData (required);
  default_argument:TemplateArgument ( java_key:"pt.up.fe.specs.clava.ast.decl.TemplateTemplateParmDecl.DEFAULT_ARGUMENT", java_codec:"optionalCompound");
  is_parameter_pack:bool = null (java_key:"pt.up.fe.specs.clava.ast.decl.TemplateTemplateParmDecl.IS_PARAMETER_PACK");
  is_pack_expansion:bool = null (java_key:"pt.up.fe.specs.clava.ast.decl.TemplateTemplateParmDecl.IS_PACK_EXPANSION");
