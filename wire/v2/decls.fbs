include "common.fbs";
namespace astwire.v2;

// Declaration payloads follow the native dumper inheritance walk. Each
// handler owns a table and embeds its parent payload in `base`.
table DeclData (clang_manual, clang_root) {
  base:ClavaNodeData (required);
  /// True if the declaration was implicitly generated by the implementation. Otherwise, this declaration was written
  /// explicitly in the source code.
  is_implicit:bool = null;
  /// True if this declaration was used, and requires a definition.
  is_used:bool = null;
  /// True if any declaration of this entity was referenced.
  is_referenced:bool = null;
  /// True if the node has a semantic error.
  is_invalid_decl:bool = null;
  /// True if this declaration was marked as being private to the module in which it was defined.
  is_module_private:bool = null;
  /// A list of attributes associated with this Decl.
  attributes:[long] (required, ref: "Attribute", clang: "node->attrs()");
}

table NamedDeclData (clang_nodes: "LabelDecl ObjCImplementationDecl UsingShadowDecl") {
  base:DeclData (required);
  qualified_prefix:string (required, clang_value: "clava::getQualifiedPrefix(node)");
  decl_name:string (required, clang_value: "node->getDeclName().getAsString()");
  name_kind:NameKind = null (clang_value: "nameKind(node->getDeclName().getNameKind())");
  /// True if this declaration is a C++ class member.
  is_cxx_class_member:bool = null (clang: "node->isCXXClassMember()");
  /// True if this declaration is an instance member of a C++ class.
  is_cxx_instance_member:bool = null (clang: "node->isCXXInstanceMember()");
  /// The linkage of the declaration from a semantic point of view.
  ///
  /// Entities in anonymous namespaces are external (in c++98).
  linkage:Linkage = null (clang: "node->getFormalLinkage()", clang_enum: "LINKAGE");
  /// The visibility of this entity.
  visibility:Visibility = null;
}

table TypeDeclData {
  base:NamedDeclData (required);
  /// The type associated with this TypeDecl.
  type_for_decl:long = null (ref: "Type", optional);
}

table TagDeclData {
  base:TypeDeclData (required);
  /// The kind of this tag (e.g., struct, union, class, enum...).
  tag_kind:TagKind = null (clang_enum: "TAG_KIND");
  /// True if this decl has its body fully specified.
  is_complete_definition:bool = null;
}

table RecordDeclData {
  base:TagDeclData (required);
  /// True if this is an anonymous struct or union.
  ///
  /// To be an anonymous struct or union, it must have been declared without a name and there must be no objects of
  /// this type declared.
  is_anonymous:bool = null (clang: "node->isAnonymousStructOrUnion()");
}

table ValueDeclData (clang_nodes: "EnumConstantDecl") {
  base:NamedDeclData (required);
  /// The type associated with this ValueDecl.
  type:long = null (ref: "Type");
  /// True if this symbol is weakly-imported, or declared with the weak or weak-reference attribute.
  is_weak:bool = null;
}

table DeclaratorDeclData {
  base:ValueDeclData (required);
}

table TemplateDeclData (clang_nodes: "ClassTemplateDecl FunctionTemplateDecl TypeAliasTemplateDecl VarTemplateDecl") {
  base:NamedDeclData (required);
  template_parameters:[long] (required, ref: "NamedDecl", clang_value: "templateParameters(node->getTemplateParameters(), c)");
  /// The underlying, templated declaration.
  template_decl:long = null (ref: "NamedDecl", optional, clang: "node->getTemplatedDecl()");
}

table FunctionDeclData {
  base:DeclaratorDeclData (required);
  /// True if this is a (C++11) constexpr function or constexpr constructor.
  is_constexpr:bool = null;
  /// The kind of templated function.
  template_kind:TemplateKind = null (clang_value: "templateKind(node->getTemplatedKind())");
  /// The storage class as written in the source.
  storage_class:StorageClass = null (clang_enum: "STORAGE_CLASS");
  /// True if the "inline" keyword was specified for this function.
  is_inline_specified:bool = null;
  /// True if this function is explicitly marked as virtual.
  is_virtual_as_written:bool = null;
  /// True if this virtual function is pure, i.e. makes the containing class abstract.
  is_pure:bool = null (clang: "node->isPureVirtual()");
  /// True if this function was deleted (via the C++0x "= delete" syntax).
  is_deleted:bool = null (clang: "node->isDeletedAsWritten()");
  /// True if this function is explicitly defaulted (via the C++0x "= default" syntax).
  is_explicitly_defaulted:bool = null;
  previous_decl:long = null (ref: "Decl", optional);
  canonical_decl:long = null (ref: "Decl");
  primary_template_decl:long = null (ref: "FunctionDecl", optional, clang_value: "primaryTemplateDecl(node, c)");
  /// Template arguments of this function, if any.
  template_arguments:[TemplateArgument] (required, clang_value: "specializationArguments(node, c)");
  template_parameters:[long] (required, ref: "NamedDecl", clang_value: "functionTemplateParameters(node, c)");
  template_parameter_list_sizes:[int] (required, clang_value: "templateParameterListSizes(node)");
}

table CXXMethodDeclData (clang_nodes: "CXXDestructorDecl") {
  base:FunctionDeclData (required);
  record:long = null (ref: "Decl", clang: "node->getParent()");
  overridden_methods:[long] (required, ref: "CXXMethodDecl", clang: "node->overridden_methods()");
  is_static:bool = null;
  is_instance:bool = null;
  is_const:bool = null;
  is_volatile:bool = null;
  is_virtual:bool = null;
  /// True if this is a copy-assignment operator, either declared implicitly or explicitly.
  is_copy_assignment_operator:bool = null;
  is_move_assignment_operator:bool = null;
  /// Return the type of the 'this' pointer. Note that for the call operator of a lambda closure type, this returns the
  /// desugared 'this' type (a pointer to the closure type), not the captured 'this' type.
  this_type:long = null (ref: "Type", optional, clang_value: "node->isInstance() ? clava::getId(node->getThisType(), c.id) : -1");
  /// The type of the object pointed by 'this'.
  this_object_type:long = null (ref: "Type", optional, clang_value: "node->isInstance() ? clava::getId(node->getFunctionObjectParameterType(), c.id) : -1");
  has_inline_body:bool = null;
  /// True if this is a lambda closure type's static member function that is used for the result of the lambda's
  /// conversion to function pointer (for a lambda with no captures).
  is_lambda_static_invoker:bool = null;
}

table CXXConstructorDeclData {
  base:CXXMethodDeclData (required);
  constructor_inits:[CXXCtorInitializer] (required, clang: "node->inits()");
  /// True if this constructor is a default constructor.
  is_default_constructor:bool = null;
  /// True if this constructor was marked "explicit".
  is_explicit:bool = null;
  /// DataClass with information about the 'explicit' keyword.
  explicit_specifier:ExplicitSpecifier (required);
}

table CXXConversionDeclData {
  base:CXXMethodDeclData (required);
  /// True if the declaration is already resolved to be explicit.
  is_explicit:bool = null;
  /// True if this conversion function is a conversion from a lambda closure type to a block pointer.
  is_lambda_to_block_pointer_conversion:bool = null;
  /// The type that this conversion function is converting to.
  conversion_type:long = null (ref: "Type");
}

table FieldDeclData {
  base:DeclaratorDeclData (required);
  is_mutable:bool = null;
}

table ParmVarDeclData {
  base:VarDeclData (required);
  has_inherited_default_arg:bool = null;
}

table VarDeclData (clang_nodes: "VarTemplateSpecializationDecl") {
  base:DeclaratorDeclData (required);
  /// The storage class as written in the source.
  storage_class:StorageClass = null (clang_enum: "STORAGE_CLASS");
  tls_kind:TLSKind = null (clang: "node->getTLSKind()");
  /// True if this local variable can be used with the named return value optimization (NRVO).
  is_nrvo_variable:bool = null (clang: "node->isNRVOVariable()");
  /// The style of initialization for this declaration.
  ///
  /// C-style initialization is "int x = 1;". Call-style initialization is a C++98 direct-initializer, e.g. "int
  /// x(1);". The Init expression will be the expression inside the parens or a "ClassType(a,b,c)" class constructor
  /// expression for class types. List-style initialization is C++11 syntax, e.g. "int x{1};". Clients can distinguish
  /// between different forms of initialization by checking this value. In particular, "int x = {1};" is C-style, "int
  /// x({1})" is call-style, and "int x{1};" is list-style; the Init expression in all three cases is an InitListExpr.
  init_style:InitializationStyle = null (clang_enum: "INIT_STYLE");
  /// True if this variable is (C++11) constexpr.
  is_constexpr:bool = null;
  /// True if this is a static data member.
  ///
  /// This will only be true in C++, and applies to, e.g., the variable 'x' in:<br>
  ///
  /// <pre>
  /// struct S {
  /// static int x;
  /// };
  /// </pre>
  is_static_data_member:bool = null;
  /// True if this is or was instantiated from an out-of-line definition of a static data member.
  is_out_of_line:bool = null;
  /// True if this variable does not have local storage.
  ///
  /// This includes all global variables as well as static variables declared within a function.
  has_global_storage:bool = null;
}

table TemplateTypeParmDeclData {
  base:TypeDeclData (required);
  kind:TemplateTypeParmKind = null (clang_value: "templateTypeParmKind(node)");
  /// True if this is a parameter pack.
  is_parameter_pack:bool = null;
  default_argument:long = null (ref: "Type", optional, clang_value: "node->hasDefaultArgument() ? clava::getId(node->getDefaultArgument(), c.id) : -1");
}

table UnresolvedUsingTypenameDeclData {
  base:TypeDeclData (required);
  qualifier:string (required, clang_value: "qualifierString(node->getQualifier(), c)");
  is_pack_expansion:bool = null;
}

table EnumDeclData {
  base:TagDeclData (required);
  enum_scope_kind:EnumScopeType = null (clang_value: "enumScopeKind(node)");
  integer_type:long = null (ref: "Type", optional);
}

table CXXRecordDeclData {
  base:RecordDeclData (required);
  /// A list of the base specifiers of this CXXRecordDecl.
  record_bases:[CXXBaseSpecifier] (required, clang_value: "recordBases(node, c)");
  record_definition:long = null (ref: "CXXRecordDecl", optional, clang: "node->getDefinition()");
}

table ClassTemplateSpecializationDeclData {
  base:CXXRecordDeclData (required);
  /// The template that this specialization specializes.
  specialized_template:long = null (ref: "ClassTemplateDecl");
  /// The kind of specialization that this declaration represents.
  specialization_kind:TemplateSpecializationKind = null (clang_enum: "TEMPLATE_SPECIALIZATION_KIND");
  /// The template arguments of the class template specialization.
  template_arguments:[TemplateArgument] (required, clang: "node->getTemplateArgs().asArray()");
}

table NonTypeTemplateParmDeclData {
  base:DeclaratorDeclData (required);
  /// The default-argument expression, if any.
  default_argument:long = null (ref: "Expr", optional, clang_value: "node->hasDefaultArgument() ? clava::getId(node->getDefaultArgument(), c.id) : -3");
  /// True if the default argument was inherited from a previous declaration of this template.
  default_argument_was_inherited:bool = null (clang: "node->defaultArgumentWasInherited()");
  /// True if this is a parameter pack.
  is_parameter_pack:bool = null;
  /// True if this parameter pack is a pack expansion.
  is_pack_expansion:bool = null;
  /// True if this parameter is a non-type template parameter pack that has a known list of different types at
  /// different positions.
  is_expanded_parameter_pack:bool = null;
  /// The expansion types in an expanded parameter pack.
  expansion_types:[long] (required, ref: "Type", clang_value: "expansionTypes(node, c)");
}

table TypedefNameDeclData (clang_nodes: "TypeAliasDecl TypedefDecl") {
  base:TypeDeclData (required);
  underlying_type:long = null (ref: "Type");
}

table AccessSpecDeclData {
  base:DeclData (required);
  access_specifier:AccessSpecifier = null (clang: "node->getAccess()", clang_enum: "ACCESS_SPECIFIER");
}

table UsingDeclData {
  base:NamedDeclData (required);
  nested_name_specifier:NestedNameSpecifier (required, clang: "node->getQualifier()");
}

table UsingDirectiveDeclData {
  base:NamedDeclData (required);
  qualifier:string (required, clang_value: "sourceText(node->getSourceRange(), c)");
  namespace:long = null (ref: "NamespaceDecl", clang: "node->getNominatedNamespace()");
  namespace_as_written:long = null (ref: "NamedDecl", clang: "node->getNominatedNamespaceAsWritten()");
}

table NamespaceDeclData {
  base:NamedDeclData (required);
  source_literal:string (required, clang_value: "sourceText(node->getSourceRange(), c)");
}

table NamespaceAliasDeclData {
  base:NamedDeclData (required);
  nested_prefix:string (required, clang_value: "sourceText(node->getQualifierLoc().getSourceRange(), c)");
  aliased_namespace:long = null (ref: "NamespaceDecl");
}

table LinkageSpecDeclData {
  base:DeclData (required);
  linkage_type:LanguageId = null (clang_value: "linkageType(node)");
}

table StaticAssertDeclData {
  base:DeclData (required);
  is_failed:bool = null;
}

table TemplateTemplateParmDeclData {
  base:TemplateDeclData (required);
  /// The default-argument expression, if any.
  default_argument:TemplateArgument (optional, clang_value: "node->hasDefaultArgument() ? makeTemplateArgument(node->getDefaultArgument().getArgument(), c) : nullptr");
  /// True if this is a parameter pack.
  is_parameter_pack:bool = null;
  /// True if this parameter pack is a pack expansion.
  is_pack_expansion:bool = null;
  /// True if this parameter is a non-type template parameter pack that has a known list of different types at
  /// different positions.
  is_expanded_parameter_pack:bool = null;
}

table MSPropertyDeclData {
  base:DeclaratorDeclData (required);
  getter_name:string (optional, clang_value: "node->hasGetter() ? node->getGetterId()->getName().str() : std::string()");
  setter_name:string (optional, clang_value: "node->hasSetter() ? node->getSetterId()->getName().str() : std::string()");
}

union DeclPayload {
  DeclData,
  NamedDeclData,
  TypeDeclData,
  TagDeclData,
  RecordDeclData,
  ValueDeclData,
  DeclaratorDeclData,
  TemplateDeclData,
  FunctionDeclData,
  CXXMethodDeclData,
  CXXConstructorDeclData,
  CXXConversionDeclData,
  FieldDeclData,
  ParmVarDeclData,
  VarDeclData,
  TemplateTypeParmDeclData,
  UnresolvedUsingTypenameDeclData,
  EnumDeclData,
  CXXRecordDeclData,
  ClassTemplateSpecializationDeclData,
  NonTypeTemplateParmDeclData,
  TypedefNameDeclData,
  AccessSpecDeclData,
  UsingDeclData,
  UsingDirectiveDeclData,
  NamespaceDeclData,
  NamespaceAliasDeclData,
  LinkageSpecDeclData,
  StaticAssertDeclData,
  TemplateTemplateParmDeclData,
  MSPropertyDeclData
}

table ClassTemplatePartialSpecializationDeclData {
  base:ClassTemplateSpecializationDeclData (required);
  template_parameters:[long] (required, ref: "NamedDecl", clang_value: "templateParameters(node->getTemplateParameters(), c)");
}
