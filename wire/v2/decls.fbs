table MSPropertyDeclData {
  base:DeclaratorDeclData (required);
  getter_name:string ( java_key:"pt.up.fe.specs.clava.ast.decl.MSPropertyDecl.GETTER_NAME", java_codec:"optionalString");
  setter_name:string ( java_key:"pt.up.fe.specs.clava.ast.decl.MSPropertyDecl.SETTER_NAME", java_codec:"optionalString");
}

union DeclPayload {
  DeclData,
  NamedDeclData,
  TypeDeclData,
  TagDeclData,
  RecordDeclData,
  ValueDeclData,
  DeclaratorDeclData,
  TemplateDeclData,
  FunctionDeclData,
  CXXMethodDeclData,
  CXXConstructorDeclData,
  CXXConversionDeclData,
  FieldDeclData,
  ParmVarDeclData,
  VarDeclData,
  TemplateTypeParmDeclData,
  UnresolvedUsingTypenameDeclData,
  EnumDeclData,
  CXXRecordDeclData,
  ClassTemplateSpecializationDeclData,
  NonTypeTemplateParmDeclData,
  TypedefNameDeclData,
  AccessSpecDeclData,
  UsingDeclData,
  UsingDirectiveDeclData,
  NamespaceDeclData,
  NamespaceAliasDeclData,
  LinkageSpecDeclData,
  StaticAssertDeclData,
  TemplateTemplateParmDeclData,
  MSPropertyDeclData
}

table ClassTemplatePartialSpecializationDeclData { base:ClassTemplateSpecializationDeclData (required); }
