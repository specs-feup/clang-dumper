include "common.fbs";
namespace astwire.v2;

// Each table mirrors one native statement handler. Inheritance is explicit
// because FlatBuffers tables do not inherit: `base` contains the full parent
// payload and ultimately ClavaNodeData/source information.
table StmtData (clang_manual, clang_root) {
  base:ClavaNodeData (required);
}

table LabelStmtData {
  base:StmtData (required);
  label:long = null (ref: "LabelDecl", clang: "node->getDecl()");
}

table GotoStmtData {
  base:StmtData (required);
  label:long = null (ref: "LabelDecl");
}

table AttributedStmtData {
  base:StmtData (required);
  stmt_attributes:[long] (required, ref: "Attribute", clang: "node->getAttrs()");
}

table AsmStmtData (clang_manual) {
  base:StmtData (required);
  is_simple:bool = null;
  is_volatile:bool = null;
  clobbers:[string] (required);
  outputs:[AsmOutput] (required);
  inputs:[AsmInput] (required);
}

table GCCAsmStmtData (clang_manual) {
  base:AsmStmtData (required);
  asm_string:string (required);
  is_goto:bool = null;
  labels:[string] (required);
  is_inline:bool = null;
}

table MSAsmStmtData {
  base:AsmStmtData (required);
  asm_string:string (required, clang_value: "getSourceMSAsmString(node, c)");
}
